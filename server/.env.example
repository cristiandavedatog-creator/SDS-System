DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=appointment

# Shared admin password used to log in to /admin on the frontend.
ADMIN_PASSWORD=

# Random secret used to sign admin session tokens, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Connection to the OFFICE's database (source for the extract-recent-data
# scripts in scripts/office-import) — separate from DB_HOST/etc above.
OFFICE_DB_HOST=
OFFICE_DB_PORT=3306
OFFICE_DB_USER=
OFFICE_DB_PASSWORD=
OFFICE_DB_NAME=
